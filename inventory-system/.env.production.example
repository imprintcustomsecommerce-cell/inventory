# Production environment template — Aiven MySQL
#
# Copy this to .env.production (gitignored) and fill in the real values,
# or paste these as environment variables in your host's dashboard.
# Never commit real credentials.

APP_NAME="Inventory System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-deployed-domain

# --- Aiven MySQL ---------------------------------------------------------
# From the Aiven console: Services > your MySQL service > Connection information.
# These are the same values you already use in MySQL Workbench.
#
# Note: Aiven uses a NON-standard port (a 5-digit number, not 3306),
# the default database is "defaultdb", and the default user is "avnadmin".
DB_CONNECTION=mysql
DB_HOST=mysql-xxxxxxx-yyyyyyy.a.aivencloud.com
DB_PORT=00000
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# Aiven refuses unencrypted connections, so the CA certificate is required.
# Download "CA Certificate" from the same Connection information panel and
# save it as storage/certs/aiven-ca.pem, then point this at it.
# The CA cert is a public certificate, not a secret — it is safe to commit.
MYSQL_ATTR_SSL_CA="${PWD}/storage/certs/aiven-ca.pem"

# --- Session / cache / queue --------------------------------------------
# SESSION_DRIVER=file does not survive on hosts with an ephemeral filesystem.
# Using the database keeps sessions working across restarts and instances.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- File storage --------------------------------------------------------
# Uploaded images and proof files are stored as bytes in the database (see the
# `media` table), so no disk or S3 bucket is needed and uploads survive on a
# serverless host. This setting only affects any remaining incidental writes.
FILESYSTEM_DISK=local

# --- Serverless (Vercel) -------------------------------------------------
# The project directory is read-only at runtime, so every path Laravel writes
# to has to be redirected to /tmp. Without these the app 500s on boot.
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp/views

# There is no persistent log file on a serverless host; stderr shows up in the
# Vercel runtime logs instead.
LOG_CHANNEL=stderr
LOG_LEVEL=error
